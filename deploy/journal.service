[Unit]
Description=手动交易日志
After=network.target

[Service]
Type=simple
User=journal
Group=journal
EnvironmentFile=/etc/journal/journal.env
ExecStart=/opt/journal/journal
WorkingDirectory=/var/lib/journal
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/journal

[Install]
WantedBy=multi-user.target
